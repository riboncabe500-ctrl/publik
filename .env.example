# Lavalink Server Configuration
LAVALINK_PASSWORD=youshallnotpass

# Server Port (Railway akan auto-expose via HTTPS)
SERVER_PORT=443

# Audio Sources (enable/disable)
LAVALINK_SERVER_SOURCES_YOUTUBE=true
LAVALINK_SERVER_SOURCES_BANDCAMP=true
LAVALINK_SERVER_SOURCES_SOUNDCLOUD=true
LAVALINK_SERVER_SOURCES_TWITCH=true
LAVALINK_SERVER_SOURCES_VIMEO=true
LAVALINK_SERVER_SOURCES_MIXER=false
LAVALINK_SERVER_SOURCES_HTTP=true
LAVALINK_SERVER_SOURCES_LOCAL=true

# SSL/TLS Configuration
SSL_KEYSTORE_PATH=/lavalink/data/keystore.p12
SSL_KEYSTORE_PASSWORD=changeme

# Java Runtime Optimization (Railway default: 512MB)
JAVA_OPTS=-Xmx512M -Xms256M -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:G1NewCollectionHeuristicPercent=35 -XX:G1ReservePercent=20 -XX:G1HeapRegionSize=16M

# Optional: Enable for debugging
DEBUG=false
LOG_LEVEL=INFO
